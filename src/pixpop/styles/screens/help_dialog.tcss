HelpDialog {
    align: center middle;

    .help-dialog {
        width: 60;
        height: auto;
        padding: 1 2;
        border: round $primary;
        background: $panel;
    }

    #help-title {
        text-style: bold;
        margin-bottom: 1;
    }

    .help-section-title {
        text-style: bold;
        margin-top: 1;
    }

    .help-section-body {
        margin-bottom: 1;
    }

    #help-hint {
        width: 1fr;
        margin-top: 1;
        color: $text-muted;
        text-align: center;
    }
}
